[Unit]
Description=personal_work_rag FastAPI service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/personal_work_rag
EnvironmentFile=/personal_work_rag/.env
ExecStart=/personal_work_rag/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
